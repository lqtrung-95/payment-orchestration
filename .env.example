# Copy to .env for local development. .env is gitignored and must never be
# committed — this file is the only one that belongs in version control.

APP_ENV=development

HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s

# Credentials here are local-stack throwaways matching deploy/docker-compose.yml.
POSTGRES_DSN=postgres://payment:payment@localhost:5432/payment?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_STATEMENT_TIMEOUT=10s

REDIS_ADDR=localhost:6379
REDIS_DB=0
REDIS_POOL_SIZE=20

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payment-orchestrator

# Fault-injecting provider simulator. Runs as its own process (make pspsim) so
# it can be killed mid-flow.
PSP_SIMULATOR_URL=http://localhost:9091
PSP_DEFAULT_PROVIDER=psp-sync-sim
# Deliberately shorter than HTTP_REQUEST_TIMEOUT: a hung provider must surface
# as a timeout this service classifies and recovers from, not as the caller
# giving up first and leaving the outcome unexamined.
PSP_TIMEOUT=5s

# pspsim itself. Port 9091, not 9090: Prometheus in the local stack binds 9090
# and the two would collide when the observability profile is running.
PSPSIM_ADDR=:9091
PSPSIM_PRESET=healthy
PSPSIM_SEED=20260811
PSPSIM_WEBHOOK_SECRET=sim-webhook-secret

LOG_LEVEL=info
LOG_FORMAT=text
LOG_ADD_SOURCE=false
