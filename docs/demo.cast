[0.100, "o", "\u001b[?25l\u001b[4A\u001b[0G[+] up 0/3\r\n \u001b[33m⠙\u001b[0m Container payment-orchestrator-kafka-1    Waiting                        \u001b[34m0.2s\u001b[0m\r\n \u001b[33m⠙\u001b[0m Container payment-orchestrator-postgres-1 Waiting                        \u001b[34m0.2s\u001b[0m\r\n \u001b[33m⠙\u001b[0m Container payment-orchestrator-redis-1    Waiting                        \u001b[34m0.2s\u001b[0m\r\n"]
